# Claude Code provider credentials
# Copy this file to:
#   ~/.config/claude-code/providers.env
#
# Then edit the copied file and protect it:
#   chmod 600 ~/.config/claude-code/providers.env
#
# Never commit the real file.

# DeepSeek Platform API key
DEEPSEEK_API_KEY="replace_with_your_deepseek_api_key"

# Kimi API Open Platform key.
# This is NOT a Kimi Code subscription key.
KIMI_API_KEY="replace_with_your_kimi_open_platform_api_key"

# Optional: Anthropic Console API key for the official Claude API.
# Leave blank when you use claude.ai subscription login instead.
ANTHROPIC_API_KEY_OFFICIAL=""
