#!/usr/bin/env bash
set -euo pipefail

readonly CC_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code"
readonly CC_ENV_FILE="${CC_CONFIG_DIR}/providers.env"

cc_die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

cc_load_secrets() {
  [[ -f "$CC_ENV_FILE" ]] || cc_die "Missing $CC_ENV_FILE. Copy providers.env.example there first."
  # shellcheck disable=SC1090
  set -a
  source "$CC_ENV_FILE"
  set +a
}

cc_require_command() {
  command -v "$1" >/dev/null 2>&1 || cc_die "Required command not found: $1"
}

cc_clear_provider_env() {
  unset ANTHROPIC_API_KEY || true
  unset ANTHROPIC_AUTH_TOKEN || true
  unset ANTHROPIC_BASE_URL || true
  unset ANTHROPIC_MODEL || true
  unset ANTHROPIC_DEFAULT_OPUS_MODEL || true
  unset ANTHROPIC_DEFAULT_SONNET_MODEL || true
  unset ANTHROPIC_DEFAULT_HAIKU_MODEL || true
  unset ANTHROPIC_DEFAULT_FABLE_MODEL || true
  unset CLAUDE_CODE_SUBAGENT_MODEL || true
  unset CLAUDE_CODE_EFFORT_LEVEL || true
  unset CLAUDE_CODE_AUTO_COMPACT_WINDOW || true
  unset ENABLE_TOOL_SEARCH || true
}

cc_require_nonempty() {
  local variable_name="$1"
  [[ -n "${!variable_name:-}" ]] || cc_die "$variable_name is empty in $CC_ENV_FILE"
}

cc_start() {
  cc_require_command claude
  exec claude "$@"
}
