#!/usr/bin/env bash
set -euo pipefail

printf '%-38s %s\n' "Variable" "Value"
printf '%-38s %s\n' "--------------------------------------" "-----"
printf '%-38s %s\n' "ANTHROPIC_BASE_URL" "${ANTHROPIC_BASE_URL:-<unset>}"
printf '%-38s %s\n' "ANTHROPIC_MODEL" "${ANTHROPIC_MODEL:-<unset>}"
printf '%-38s %s\n' "ANTHROPIC_DEFAULT_OPUS_MODEL" "${ANTHROPIC_DEFAULT_OPUS_MODEL:-<unset>}"
printf '%-38s %s\n' "ANTHROPIC_DEFAULT_SONNET_MODEL" "${ANTHROPIC_DEFAULT_SONNET_MODEL:-<unset>}"
printf '%-38s %s\n' "ANTHROPIC_DEFAULT_HAIKU_MODEL" "${ANTHROPIC_DEFAULT_HAIKU_MODEL:-<unset>}"
printf '%-38s %s\n' "CLAUDE_CODE_SUBAGENT_MODEL" "${CLAUDE_CODE_SUBAGENT_MODEL:-<unset>}"
printf '%-38s %s\n' "CLAUDE_CODE_EFFORT_LEVEL" "${CLAUDE_CODE_EFFORT_LEVEL:-<unset>}"
printf '%-38s %s\n' "ENABLE_TOOL_SEARCH" "${ENABLE_TOOL_SEARCH:-<unset>}"
printf '%-38s %s\n' "Credential" "$(
  if [[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
    printf '<ANTHROPIC_AUTH_TOKEN is set>'
  elif [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    printf '<ANTHROPIC_API_KEY is set>'
  else
    printf '<not set in this shell>'
  fi
)"
