#!/usr/bin/env bash
set -euo pipefail

readonly BIN_DIR="${HOME}/.local/bin"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code"
readonly ENV_FILE="${CONFIG_DIR}/providers.env"
readonly BASHRC="${HOME}/.bashrc"

readonly BIN_FILES=(
  cc-common
  cc-deepseek
  cc-kimi
  cc-anthropic
  cc-which
  cc-remove-all
)

cat <<EOF

========================================
  Claude Code multi-provider -- 全面清理
========================================

This will remove:

  • Launcher commands from ${BIN_DIR}/
  • Credential file         ${ENV_FILE}
  • PATH entry             from ${BASHRC} (the ~/.local/bin line)
  • Empty config dir        ${CONFIG_DIR}/

EOF

if [[ -f "$ENV_FILE" ]]; then
  printf 'WARNING: %s contains real API keys.\n' "$ENV_FILE"
  printf 'This action is IRREVERSIBLE.\n\n'
fi

read -r -p "Type 'yes' to confirm full removal: " CONFIRM
if [[ "$CONFIRM" != "yes" ]]; then
  printf 'Aborted.\n'
  exit 0
fi

printf '\n--- Removing launcher commands ---\n'
for bin in "${BIN_FILES[@]}"; do
  if [[ -f "${BIN_DIR}/${bin}" ]]; then
    rm -f "${BIN_DIR}/${bin}"
    printf '  removed: %s/%s\n' "$BIN_DIR" "$bin"
  else
    printf '  skipped (not found): %s/%s\n' "$BIN_DIR" "$bin"
  fi
done

printf '\n--- Removing credential file ---\n'
if [[ -f "$ENV_FILE" ]]; then
  rm -f "$ENV_FILE"
  printf '  removed: %s\n' "$ENV_FILE"
else
  printf '  skipped (not found): %s\n' "$ENV_FILE"
fi

printf '\n--- Cleaning PATH in %s ---\n' "$BASHRC"
if [[ -f "$BASHRC" ]]; then
  if grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$BASHRC" 2>/dev/null; then
    sed -i '/export PATH="$HOME\/.local\/bin:\$PATH"/d' "$BASHRC"
    printf '  removed PATH line from %s\n' "$BASHRC"
  else
    printf '  PATH line not found in %s\n' "$BASHRC"
  fi
else
  printf '  skipped: %s does not exist\n' "$BASHRC"
fi

printf '\n--- Cleaning empty config directory ---\n'
if [[ -d "$CONFIG_DIR" ]]; then
  if [[ -z "$(ls -A "$CONFIG_DIR" 2>/dev/null)" ]]; then
    rmdir "$CONFIG_DIR"
    printf '  removed empty: %s\n' "$CONFIG_DIR"
  else
    printf '  skipped: %s is not empty\n' "$CONFIG_DIR"
  fi
else
  printf '  skipped (not found): %s\n' "$CONFIG_DIR"
fi

printf '\nDone. Run "source ~/.bashrc" or open a new terminal.\n'
